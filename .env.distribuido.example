# Modo distribuido (docker-compose.distribuido.yml): claves comunes.
# Copiar a .env.distribuido (NO subirlo al repositorio) y cambiar las claves.
# El archivo debe ser IDÉNTICO en pc1, pc2, pc3 y pc4: cópialo de una PC a las demás.

# Broker (pc4). Todas las PCs se conectan con este usuario.
RABBITMQ_USER=newsproject
RABBITMQ_PASS=cambiar_esta_clave

# Una credencial por base de datos (cada BD vive dentro del contenedor de su servicio)
INGESTA_DB_USER=ingesta
INGESTA_DB_PASS=cambiar_esta_clave

CLASIFICACION_DB_USER=clasificacion
CLASIFICACION_DB_PASS=cambiar_esta_clave

BUSQUEDA_DB_USER=busqueda
BUSQUEDA_DB_PASS=cambiar_esta_clave

USUARIOS_DB_USER=usuarios
USUARIOS_DB_PASS=cambiar_esta_clave

NOTIFICACIONES_DB_USER=notificaciones
NOTIFICACIONES_DB_PASS=cambiar_esta_clave

# Clasificación: probabilidad mínima para no caer en la categoría "otros"
CLASIFICACION_MIN_SCORE=0.5

# Autenticación (docs/arquitectura.md, sección 7.1)
# Secreto para firmar los JWT: lo usan Usuarios y el gateway (ambos en pc1). Usa 32+ caracteres aleatorios
# (por ejemplo: python3 -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio_de_32_o_mas
# Primer administrador: Usuarios lo crea al arrancar si no existe ese correo.
ADMIN_EMAIL=admin@newsproject.local
ADMIN_PASSWORD=cambiar_esta_clave_admin
ADMIN_USERNAME=admin

# Ingesta: cada cuántos minutos revisa automáticamente las fuentes activas
INGESTA_SCRAPING_INTERVAL_MINUTES=5

# Notificaciones: días que se conservan las alertas (y los artículos recientes para el relleno)
NOTIFICACIONES_ALERTS_RETENTION_DAYS=7

# Panel del administrador: usuario de RabbitMQ de solo monitoreo (lo crea rabbitmq-init)
RABBITMQ_MONITOR_USER=monitor
RABBITMQ_MONITOR_PASS=cambiar_esta_clave_monitor

# Solo modo distribuido: secreto compartido entre el gateway y los servicios, para que un
# servicio expuesto en la red acepte solo peticiones que vengan del gateway.
# Usa 32+ caracteres aleatorios (mismo comando que JWT_SECRET) y que sea distinto de JWT_SECRET.
DISTRIBUTED_INTERNAL_TOKEN=cambiar_este_token_interno_largo_y_aleatorio_de_32_o_mas
