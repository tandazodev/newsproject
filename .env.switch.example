# Modo distribuido por switch o red local (deploy/levantar.sh switch).
# Copiar a .env.switch (NO subirlo al repositorio). Debe ser IDÉNTICO en las 4 PCs.
# Cambia cada IP por la IP fija que tenga esa PC en la red local (ip -4 addr).
#
#   pc1: entrada (gateway + frontend) y usuarios
#   pc2: ingesta
#   pc3: clasificacion y busqueda
#   pc4: broker (RabbitMQ) y notificaciones

PC1_IP=192.168.50.11
PC2_IP=192.168.50.12
PC3_IP=192.168.50.13
PC4_IP=192.168.50.14
