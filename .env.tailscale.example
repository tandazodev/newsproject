# Modo distribuido por Tailscale (deploy/levantar.sh tailscale).
# Copiar a .env.tailscale (NO subirlo al repositorio). Debe ser IDÉNTICO en las 4 PCs.
# Cambia cada valor por la IP 100.x que Tailscale asignó a esa PC
# (en cada PC: tailscale ip -4, o en la consola de administración de Tailscale).
#
#   pc1: entrada (gateway + frontend) y usuarios
#   pc2: ingesta
#   pc3: clasificacion y busqueda
#   pc4: broker (RabbitMQ) y notificaciones

PC1_IP=100.64.0.1
PC2_IP=100.64.0.2
PC3_IP=100.64.0.3
PC4_IP=100.64.0.4
